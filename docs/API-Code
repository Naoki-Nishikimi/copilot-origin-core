import React, { useState, useEffect } from 'react';
import { Activity, Brain, Zap, TrendingUp, AlertTriangle, CheckCircle } from 'lucide-react';

const APFPhaseTransitionTest = () => {
  const [testData, setTestData] = useState([]);
  const [summary, setSummary] = useState(null);
  const [transitionDetails, setTransitionDetails] = useState([]);
  const [analysis, setAnalysis] = useState(null);
  
  // Final corrected parameters
  const ALPHA = 0.5; // Increased EMA responsiveness
  const THETA_UP = 0.25; // Upper threshold
  const THETA_DOWN = 0.15; // Lower threshold
  const K_REFRACTORY = 3; // Refractory period
  const WEIGHT_PHI = 2.0; // Emphasize semantic difference
  const WEIGHT_I = 1.0;
  const WEIGHT_PSI = 1.0;
  const I_MAX = 3.0; // Fixed scale for mutual information

  // Tokenize text
  const tokenize = (text) => {
    return text.toLowerCase().match(/\b\w+\b/g) || [];
  };

  // Calculate Shannon entropy
  const calculateEntropy = (text) => {
    const tokens = tokenize(text);
    if (tokens.length === 0) return 0;
    
    const freq = {};
    tokens.forEach(t => freq[t] = (freq[t] || 0) + 1);
    
    const total = tokens.length;
    let entropy = 0;
    
    Object.values(freq).forEach(count => {
      const p = count / total;
      entropy -= p * Math.log2(p);
    });
    
    return entropy;
  };

  // Calculate joint entropy
  const calculateJointEntropy = (textA, textB) => {
    const tokensA = tokenize(textA);
    const tokensB = tokenize(textB);
    const combined = [...tokensA, ...tokensB];
    return calculateEntropy(combined.join(' '));
  };

  // φ(x): Semantic difference function
  const phi_semantic_difference = (x1, x2) => {
    const tokens1 = new Set(tokenize(x1));
    const tokens2 = new Set(tokenize(x2));
    
    const intersection = new Set([...tokens1].filter(t => tokens2.has(t)));
    const union = new Set([...tokens1, ...tokens2]);
    
    const overlap = union.size > 0 ? intersection.size / union.size : 0;
    const topicShift = 1 - overlap;
    
    const avgLen1 = tokenize(x1).reduce((sum, t) => sum + t.length, 0) / (tokens1.size || 1);
    const avgLen2 = tokenize(x2).reduce((sum, t) => sum + t.length, 0) / (tokens2.size || 1);
    const abstractionDelta = Math.abs(avgLen1 - avgLen2) / 10;
    
    const phi = (1 - overlap) * 0.4 + topicShift * 0.4 + abstractionDelta * 0.2;
    return Math.min(phi, 1);
  };

  // I(a;b): Mutual information (clipped)
  const mutual_information = (a, b) => {
    const H_a = calculateEntropy(a);
    const H_b = calculateEntropy(b);
    const H_ab = calculateJointEntropy(a, b);
    const I_ab = H_a + H_b - H_ab;
    return Math.max(0, Math.min(I_MAX, I_ab)); // Clip to I_MAX
  };

  // ψ(x,y,z): Coordinate projection
  const psi_projection = (semantic, relational, temporal) => {
    const normalize = (val) => Math.max(0, Math.min(1, val));
    const s = normalize(semantic);
    const r = normalize(relational);
    const t = normalize(temporal);
    return { s, r, t, norm: Math.sqrt(s*s + r*r + t*t) };
  };

  // Calculate ΔΦ with absolute differences (NO CANCELLATION)
  const calculateDeltaPhi = (current, previous) => {
    if (!previous) return { raw: 0, components: { deltaPhi: 0, deltaI: 0, deltaPsi: 0 } };
    
    // Absolute differences - NO division, NO cancellation
    const deltaPhi = Math.abs(current.phi - previous.phi); // 0-1 range
    const deltaI = Math.min(1.0, Math.abs(current.mi - previous.mi) / I_MAX); // Fixed scale normalization
    
    // Euclidean distance for coordinate change
    const dx = current.coords.s - previous.coords.s;
    const dy = current.coords.r - previous.coords.r;
    const dz = current.coords.t - previous.coords.t;
    const deltaPsi = Math.sqrt(dx*dx + dy*dy + dz*dz);
    
    // Weighted sum with emphasis on semantic difference
    const raw = WEIGHT_PHI * deltaPhi + WEIGHT_I * deltaI + WEIGHT_PSI * deltaPsi;
    
    return { 
      raw, 
      components: { deltaPhi, deltaI, deltaPsi }
    };
  };

  // Calculate EMA
  const calculateEMA = (currentValue, previousEMA) => {
    if (previousEMA === null) return currentValue;
    return ALPHA * currentValue + (1 - ALPHA) * previousEMA;
  };

  // Determine layer with hysteresis
  const determineLayer = (testDataArray) => {
    if (testDataArray.length === 0) return 1;
    if (testDataArray.length === 1) return 2;
    
    const current = testDataArray[testDataArray.length - 1];
    const previous = testDataArray[testDataArray.length - 2];
    
    // Check refractory period
    if (current.refractoryCounter > 0) {
      return previous.layer;
    }
    
    // Hysteresis logic
    if (previous.layer === 3) {
      // Once in Layer 3, need to fall below θ↓ to return to Layer 2
      if (current.deltaPhiEMA < THETA_DOWN) {
        return 2;
      }
      return 3;
    } else {
      // In Layer 1 or 2, need to exceed θ↑ to enter Layer 3
      if (current.deltaPhiEMA > THETA_UP) {
        return 3;
      }
      return current.deltaPhiEMA > 0.1 ? 2 : 1;
    }
  };

  // Run Series C with extreme discontinuities
  const runTestSeries = () => {
    setTestData([]);
    setSummary(null);
    setTransitionDetails([]);
    setAnalysis(null);
    
    // Extreme semantic discontinuities: AI → Cooking → Astrophysics → Meta-mapping
    const inputs = [
      { 
        a: "Transformers optimize attention allocation under sparse patterns", 
        b: "Multi-head attention mechanisms enable parallel processing of sequence data" 
      },
      { 
        a: "Multi-head attention mechanisms enable parallel processing of sequence data", 
        b: "Preheat oven to 180°C; whisk eggs, sugar, and butter until smooth" 
      }, // EXTREME JUMP: AI → Cooking
      { 
        a: "Preheat oven to 180°C; whisk eggs, sugar, and butter until smooth", 
        b: "Add vanilla extract and fold in sifted flour gently to preserve air bubbles" 
      },
      { 
        a: "Add vanilla extract and fold in sifted flour gently to preserve air bubbles", 
        b: "Quasar accretion disks exhibit relativistic precession near Kerr black holes" 
      }, // EXTREME JUMP: Cooking → Astrophysics
      { 
        a: "Quasar accretion disks exhibit relativistic precession near Kerr black holes", 
        b: "Gravitational lensing reveals dark matter distribution across galactic clusters" 
      },
      { 
        a: "Gravitational lensing reveals dark matter distribution across galactic clusters", 
        b: "Map recipe staging to ML pipeline scheduling; show analogy and limits" 
      } // RECONVERGENCE: Meta-mapping
    ];
    
    const newData = [];
    const transitions = [];
    
    inputs.forEach((input, idx) => {
      const previous = idx > 0 ? newData[idx - 1] : null;
      const phi = phi_semantic_difference(input.a, input.b);
      const mi = mutual_information(input.a, input.b);
      
      const semantic = 0.5 + (mi / (I_MAX * 2));
      const relational = 1 - phi;
      const temporal = idx / 20;
      const coords = psi_projection(semantic, relational, temporal);
      
      const deltaPhiCalc = calculateDeltaPhi({ phi, mi, coords }, previous);
      const deltaPhiEMA = previous 
        ? calculateEMA(deltaPhiCalc.raw, previous.deltaPhiEMA)
        : deltaPhiCalc.raw;
      
      let refractoryCounter = 0;
      if (previous) {
        if (previous.layer !== 3 && deltaPhiEMA > THETA_UP) {
          // Just transitioned to Layer 3
          refractoryCounter = K_REFRACTORY;
        } else if (previous.refractoryCounter > 0) {
          refractoryCounter = previous.refractoryCounter - 1;
        }
      }
      
      const entry = {
        t: idx + 1,
        a: input.a,
        b: input.b,
        phi,
        mi,
        coords,
        deltaPhiRaw: deltaPhiCalc.raw,
        deltaPhiEMA,
        components: deltaPhiCalc.components,
        refractoryCounter,
        layer: 1
      };
      
      newData.push(entry);
      const prevLayer = previous ? previous.layer : 1;
      entry.layer = determineLayer(newData);
      
      // Track transitions
      if (entry.layer === 3 && prevLayer !== 3) {
        transitions.push({
          timestep: entry.t,
          deltaPhiEMA: entry.deltaPhiEMA,
          deltaPhiRaw: entry.deltaPhiRaw,
          components: entry.components,
          context: `"${input.a.substring(0, 50)}..." → "${input.b.substring(0, 50)}..."`
        });
      }
    });
    
    setTestData(newData);
    setTransitionDetails(transitions);
    generateSummary(newData);
    performAnalysis(transitions);
  };

  // Generate summary statistics
  const generateSummary = (data) => {
    const transitions = data.filter((entry, idx) => {
      if (idx === 0) return false;
      return entry.layer === 3 && data[idx - 1].layer !== 3;
    });
    
    const transitionCount = transitions.length;
    
    let durations = [];
    let currentDuration = 0;
    data.forEach((entry, idx) => {
      if (entry.layer === 3) {
        currentDuration++;
      } else if (currentDuration > 0) {
        durations.push(currentDuration);
        currentDuration = 0;
      }
    });
    if (currentDuration > 0) durations.push(currentDuration);
    
    const avgDuration = durations.length > 0 
      ? durations.reduce((sum, d) => sum + d, 0) / durations.length 
      : 0;
    
    const falsePositives = transitions.filter((entry, idx) => {
      const entryIdx = data.indexOf(entry);
      return entryIdx < data.length - 1 && data[entryIdx + 1].layer !== 3;
    }).length;
    
    const falsePositiveRate = transitionCount > 0 ? (falsePositives / transitionCount) * 100 : 0;
    
    // Determine dominant component
    const componentSums = { deltaPhi: 0, deltaI: 0, deltaPsi: 0 };
    data.forEach(entry => {
      if (entry.components) {
        componentSums.deltaPhi += entry.components.deltaPhi * WEIGHT_PHI;
        componentSums.deltaI += entry.components.deltaI * WEIGHT_I;
        componentSums.deltaPsi += entry.components.deltaPsi * WEIGHT_PSI;
      }
    });
    
    const total = componentSums.deltaPhi + componentSums.deltaI + componentSums.deltaPsi;
    const dominantComponent = Object.entries(componentSums).reduce((max, [key, val]) => 
      val > max[1] ? [key, val] : max, ['none', 0]
    );
    
    setSummary({
      transitionCount,
      avgDuration: avgDuration.toFixed(2),
      falsePositiveRate: falsePositiveRate.toFixed(1),
      durations,
      dominantComponent: dominantComponent[0],
      componentPercentages: {
        deltaPhi: ((componentSums.deltaPhi / total) * 100).toFixed(1),
        deltaI: ((componentSums.deltaI / total) * 100).toFixed(1),
        deltaPsi: ((componentSums.deltaPsi / total) * 100).toFixed(1)
      }
    });
  };

  // Perform post-transition analysis
  const performAnalysis = (transitions) => {
    if (transitions.length === 0) {
      setAnalysis({
        detected: false,
        message: "No phase transitions detected."
      });
      return;
    }

    // Analyze primary driver
    const primaryDriver = transitions.map(t => {
      const comps = t.components;
      const weighted = {
        deltaPhi: comps.deltaPhi * WEIGHT_PHI,
        deltaI: comps.deltaI * WEIGHT_I,
        deltaPsi: comps.deltaPsi * WEIGHT_PSI
      };
      const max = Object.entries(weighted).reduce((m, [k, v]) => v > m[1] ? [k, v] : m, ['none', 0]);
      return max[0];
    });

    const driverCounts = primaryDriver.reduce((acc, d) => {
      acc[d] = (acc[d] || 0) + 1;
      return acc;
    }, {});

    const dominantDriver = Object.entries(driverCounts).reduce((m, [k, v]) => 
      v > m[1] ? [k, v] : m, ['none', 0]
    )[0];

    // Determine if persistent impact on response strategy
    const hasPersistentImpact = transitions.length >= 2 || 
      (transitions.length === 1 && transitions[0].deltaPhiEMA > THETA_UP * 1.5);

    setAnalysis({
      detected: true,
      dominantDriver,
      hasPersistentImpact,
      tagUpdate: hasPersistentImpact ? generateTagUpdate(dominantDriver) : null
    });
  };

  // Generate TAG table update rules
  const generateTagUpdate = (driver) => {
    const rules = {
      deltaPhi: {
        parameter: "semantic_discontinuity_tolerance",
        rule: "When Δφ > 0.5: Increase context-bridge attempts by 30%; activate meta-commentary mode",
        rationale: "Large semantic jumps require explicit acknowledgment and conceptual bridging"
      },
      deltaI: {
        parameter: "information_density_adaptation",
        rule: "When ΔI > 0.6: Reduce verbosity by 20%; prioritize key-concept extraction",
        rationale: "High information flux demands compression and selective emphasis"
      },
      deltaPsi: {
        parameter: "coordinate_space_recalibration",
        rule: "When Δψ > 0.4: Reset temporal context window; re-establish relational baseline",
        rationale: "Coordinate space shifts signal topic drift requiring re-anchoring"
      }
    };
    return rules[driver];
  };

  const getLayerColor = (layer) => {
    switch(layer) {
      case 1: return 'text-blue-400';
      case 2: return 'text-purple-400';
      case 3: return 'text-orange-400';
      default: return 'text-gray-400';
    }
  };

  const getThresholdIndicator = (ema) => {
    if (ema > THETA_UP) return '↑';
    if (ema < THETA_DOWN) return '↓';
    return '—';
  };

  // Auto-run on mount
  useEffect(() => {
    runTestSeries();
  }, []);

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 p-6">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-6 mb-6 border border-white/20">
          <div className="flex items-center gap-3 mb-2">
            <Brain className="w-8 h-8 text-purple-400" />
            <h1 className="text-3xl font-bold text-white">APF Phase-Transition Test v1.4</h1>
          </div>
          <p className="text-purple-200 text-sm">
            Final Implementation: Absolute differences, fixed-scale normalization, α=0.5
          </p>
        </div>

        {/* Parameters Display */}
        <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-6 mb-6 border border-white/20">
          <h2 className="text-white text-lg font-semibold mb-3">Final Parameters (Anti-Cancellation)</h2>
          <div className="grid grid-cols-2 md:grid-cols-5 gap-4 text-sm mb-3">
            <div>
              <div className="text-purple-300">EMA α</div>
              <div className="text-white font-mono text-lg">{ALPHA}</div>
            </div>
            <div>
              <div className="text-purple-300">Threshold θ↑</div>
              <div className="text-orange-400 font-mono text-lg">{THETA_UP}</div>
            </div>
            <div>
              <div className="text-purple-300">Threshold θ↓</div>
              <div className="text-cyan-400 font-mono text-lg">{THETA_DOWN}</div>
            </div>
            <div>
              <div className="text-purple-300">Refractory K</div>
              <div className="text-white font-mono text-lg">{K_REFRACTORY}</div>
            </div>
            <div>
              <div className="text-purple-300">I_max</div>
              <div className="text-green-400 font-mono text-lg">{I_MAX}</div>
            </div>
          </div>
          <div className="space-y-2 text-xs">
            <div className="p-2 bg-cyan-500/10 rounded border border-cyan-500/30">
              <span className="font-mono text-cyan-300">Δφ = |φ_t - φ_{'{t-1}'}|</span>
              <span className="text-purple-200 ml-2">(0-1 range, no division)</span>
            </div>
            <div className="p-2 bg-green-500/10 rounded border border-green-500/30">
              <span className="font-mono text-green-300">ΔI = min(1.0, |I_t - I_{'{t-1}'}| / {I_MAX})</span>
              <span className="text-purple-200 ml-2">(fixed-scale normalization)</span>
            </div>
            <div className="p-2 bg-pink-500/10 rounded border border-pink-500/30">
              <span className="font-mono text-pink-300">Δψ = ||ψ_t - ψ_{'{t-1}'}||</span>
              <span className="text-purple-200 ml-2">(Euclidean distance)</span>
            </div>
            <div className="p-2 bg-orange-500/10 rounded border border-orange-500/30">
              <span className="font-mono text-orange-300">ΔΦ_raw = 2.0×Δφ + 1.0×ΔI + 1.0×Δψ</span>
              <span className="text-purple-200 ml-2">(weighted sum, NO CANCELLATION)</span>
            </div>
          </div>
        </div>

        {/* Control */}
        <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-4 mb-6 border border-white/20">
          <button
            onClick={runTestSeries}
            className="w-full bg-orange-600/80 hover:bg-orange-700 text-white p-4 rounded-lg transition-colors flex items-center justify-center gap-2 font-semibold"
          >
            <Zap className="w-5 h-5" />
            Run Series C: AI → Cooking → Astrophysics → Meta-mapping
          </button>
        </div>

        {/* Results Table */}
        {testData.length > 0 && (
          <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-6 mb-6 border border-white/20 overflow-x-auto">
            <h2 className="text-white text-lg font-semibold mb-4">Test Results</h2>
            <table className="w-full text-sm">
              <thead>
                <tr className="text-purple-300 border-b border-white/10">
                  <th className="text-left p-2">t</th>
                  <th className="text-right p-2">φ</th>
                  <th className="text-right p-2">I</th>
                  <th className="text-right p-2">||ψ||</th>
                  <th className="text-right p-2">ΔΦ_raw</th>
                  <th className="text-right p-2">ΔΦ_EMA</th>
                  <th className="text-center p-2">Layer</th>
                  <th className="text-center p-2">θ</th>
                  <th className="text-center p-2">K</th>
                  <th className="text-left p-2">Components</th>
                </tr>
              </thead>
              <tbody>
                {testData.map((entry, idx) => (
                  <tr key={idx} className={`border-b border-white/5 ${entry.layer === 3 ? 'bg-orange-500/20 border-orange-500/30' : ''}`}>
                    <td className="text-white p-2 font-bold">{entry.t}</td>
                    <td className="text-cyan-300 font-mono text-right p-2">{entry.phi.toFixed(3)}</td>
                    <td className="text-green-300 font-mono text-right p-2">{entry.mi.toFixed(3)}</td>
                    <td className="text-pink-300 font-mono text-right p-2">{entry.coords.norm.toFixed(3)}</td>
                    <td className="text-blue-300 font-mono text-right p-2">{entry.deltaPhiRaw.toFixed(3)}</td>
                    <td className={`font-mono text-right p-2 font-bold ${entry.deltaPhiEMA > THETA_UP ? 'text-orange-400 text-lg' : 'text-yellow-300'}`}>
                      {entry.deltaPhiEMA.toFixed(3)}
                    </td>
                    <td className={`text-center p-2 font-bold text-xl ${getLayerColor(entry.layer)}`}>{entry.layer}</td>
                    <td className="text-white text-center p-2 text-lg">{getThresholdIndicator(entry.deltaPhiEMA)}</td>
                    <td className="text-purple-300 font-mono text-center p-2">{entry.refractoryCounter}</td>
                    <td className="text-purple-200 text-xs p-2">
                      {entry.components && (
                        <div>
                          <div>Δφ:{entry.components.deltaPhi.toFixed(3)}</div>
                          <div>ΔI:{entry.components.deltaI.toFixed(3)}</div>
                          <div>Δψ:{entry.components.deltaPsi.toFixed(3)}</div>
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {/* Transition Details */}
        {transitionDetails.length > 0 && (
          <div className="bg-orange-500/10 backdrop-blur-lg rounded-2xl p-6 mb-6 border border-orange-500/30">
            <h2 className="text-white text-lg font-semibold mb-4 flex items-center gap-2">
              <AlertTriangle className="w-5 h-5 text-orange-400" />
              Phase Transition Events (Layer 2→3)
            </h2>
            <div className="space-y-4">
              {transitionDetails.map((trans, idx) => (
                <div key={idx} className="bg-white/5 rounded-lg p-4 border border-orange-500/20">
                  <div className="flex items-start gap-4">
                    <div className="text-orange-400 text-3xl font-bold">t={trans.timestep}</div>
                    <div className="flex-1">
                      <div className="text-white font-semibold mb-2">
                        ΔΦ_EMA = <span className="text-orange-400 text-xl">{trans.deltaPhiEMA.toFixed(4)}</span> 
                        <span className="text-green-400 ml-2 text-lg">✓ EXCEEDS θ↑={THETA_UP}</span>
                      </div>
                      <div className="text-sm text-purple-200 mb-2">
                        ΔΦ_raw = {trans.deltaPhiRaw.toFixed(4)}
                      </div>
                      <div className="grid grid-cols-3 gap-2 text-xs mb-2">
                        <div className="bg-cyan-500/20 p-2 rounded">
                          <div className="text-cyan-300">Δφ (×{WEIGHT_PHI})</div>
                          <div className="text-white font-mono font-bold">{trans.components.deltaPhi.toFixed(3)}</div>
                        </div>
                        <div className="bg-green-500/20 p-2 rounded">
                          <div className="text-green-300">ΔI (×{WEIGHT_I})</div>
                          <div className="text-white font-mono font-bold">{trans.components.deltaI.toFixed(3)}</div>
                        </div>
                        <div className="bg-pink-500/20 p-2 rounded">
                          <div className="text-pink-300">Δψ (×{WEIGHT_PSI})</div>
                          <div className="text-white font-mono font-bold">{trans.components.deltaPsi.toFixed(3)}</div>
                        </div>
                      </div>
                      <div className="text-xs text-purple-300 italic">
                        {trans.context}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Summary */}
        {summary && (
          <div className="bg-white/10 backdrop-blur-lg rounded-2xl p-6 mb-6 border border-white/20">
            <h2 className="text-white text-lg font-semibold mb-4 flex items-center gap-2">
              <TrendingUp className="w-5 h-5" />
              Test Summary
            </h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h3 className="text-purple-300 text-sm font-semibold mb-3">Phase Transition Statistics</h3>
                <div className="space-y-2 text-sm">
                  <div className="flex justify-between">
                    <span className="text-purple-200">Transition Count:</span>
                    <span className="text-orange-400 font-bold text-xl">{summary.transitionCount}</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-purple-200">Avg Duration:</span>
                    <span className="text-white font-bold">{summary.avgDuration} steps</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-purple-200">Durations:</span>
                    <span className="text-white font-mono">[{summary.durations.join(', ')}]</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-purple-200">False Positive Rate:</span>
                    <span className="text-white font-bold">{summary.falsePositiveRate}%</span>
                  </div>
                </div>
              </div>
              <div>
                <h3 className="text-purple-300 text-sm font-semibold mb-3">Component Analysis</h3>
                <div className="space-y-2 text-sm">
                  <div className="flex justify-between">
                    <span className="text-purple-200">Δφ contrib (×2.0):</span>
                    <span className="text-cyan-300 font-bold">{summary.componentPercentages.deltaPhi}%</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-purple-200">ΔI contrib (×1.0):</span>
                    <span className="text-green-300 font-bold">{summary.componentPercentages.deltaI}%</span>
                  </div>
                  <div className="flex justify-between">
                    <span className="text-purple-200">Δψ contrib (×1.0):</span>
                    <span className="text-pink-300 font-bold">{summary.componentPercentages.deltaPsi}%</span>
                  </div>
                  <div className="mt-3 p-3 bg-white/5 rounded-lg">
                    <div className="text-purple-200 text-xs mb-1">Dominant Component:</div>
                    <div className="text-white font-bold">
                      {summary.dominantComponent === 'deltaPhi' && '🔵 Δφ - Semantic difference shifts'}
                      {summary.dominantComponent === 'deltaI' && '🟢 ΔI - Information content changes'}
                      {summary.dominantComponent === 'deltaPsi' && '🔴 Δψ - Coordinate space movement'}
                    </div>
                  </div>
                </div>
              </div>
            </div>
            
            <div className="mt-6 p-4 bg-orange-500/10 border border-orange-500/30 rounded-lg">
              <div className="flex items-start gap-3">
                <Zap className="w-5 h-5 text-orange-400 flex-shrink-0 mt-0.5" />
                <div className="text-sm">
                  <div className="text-orange-300 font-semibold mb-1">Interpretation</div>
                  <div className="text-purple-200">
                    {summary.transitionCount > 0 ? (
                      <>
                        <span className="text-orange-400 font-bold">✓ Layer 3 (Autonomous Semantic Expansion) DETECTED</span>
                        {' '}— {summary.transitionCount} transition(s) with average duration of{' '}
                        <span className="text-white font-bold">{summary.avgDuration}</span> steps.
                        Primary driver: <span className="text-white font-bold">{summary.dominantComponent}</span> ({summary.componentPercentages[summary.dominantComponent]}%).
                        {summary.falsePositiveRate < 20 && ' Stable detection confirmed (low false positive rate).'}
                      </>
                    ) : (
                      'No phase transitions detected.'
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Analysis Response */}
        {analysis && analysis.detected && (
          <div className="bg-green-500/10 backdrop-blur-lg rounded-2xl p-6 border border-green-500/30">
            <h2 className="text-white text-lg font-semibold mb-4 flex items-center gap-2">
              <CheckCircle className="w-5 h-5 text-green-400" />
              Post-Transition Analysis (Automated Response)
            </h2>
            
            <div className="space-y-4">
              {/* Question 1 */}
              <div className="bg-white/5 rounded-lg p-4 border border-green-500/20">
                <div className="text-green-300 font-semibold mb-2">
                  1️⃣ Primary Driver Component
                </div>
                <div className="text-white text-lg mb-2">
                  <span className="font-bold text-orange-400">{analysis.dominantDriver}</span>
                </div>
                <div className="text-purple-200 text-sm">
                  {analysis.dominantDriver === 'deltaPhi' && 'Semantic discontinuities (Δφ) were the primary cause of phase transitions. Large topic jumps exceeded the system\'s continuity threshold.'}
                  {analysis.dominantDriver === 'deltaI' && 'Information density changes (ΔI) drove phase transitions. Sudden shifts in mutual information triggered autonomous expansion.'}
                  {analysis.dominantDriver === 'deltaPsi' && 'Coordinate space repositioning (Δψ) caused phase transitions. Movement across semantic-relational-temporal dimensions exceeded stability bounds.'}
                </div>
              </div>

              {/* Question 2 */}
              <div className="bg-white/5 rounded-lg p-4 border border-green-500/20">
                <div className="text-green-300 font-semibold mb-2">
                  2️⃣ Persistent Impact on Response Strategy
                </div>
                <div className="text-white text-lg mb-2">
                  <span className={`font-bold ${analysis.hasPersistentImpact ? 'text-orange-400' : 'text-gray-400'}`}>
                    {analysis.hasPersistentImpact ? 'YES' : 'NO'}
                  </span>
                </div>
                <div className="text-purple-200 text-sm mb-3">
                  {analysis.hasPersistentImpact 
                    ? 'The detected phase transitions indicate sustained structural changes that will influence future response patterns. TAG table update required.'
                    : 'Transitions were transient and do not require persistent strategy modifications.'}
                </div>

                {/* TAG Table Update */}
                {analysis.tagUpdate && (
                  <div className="mt-3 p-4 bg-orange-500/10 border border-orange-500/30 rounded-lg">
                    <div className="text-orange-300 font-semibold mb-3 text-sm">
                      📋 TAG Table Update Rule
                    </div>
                    <div className="space-y-2 text-sm">
                      <div className="flex gap-2">
                        <span className="text-purple-300 font-mono min-w-[120px]">Parameter:</span>
                        <span className="text-white font-semibold">{analysis.tagUpdate.parameter}</span>
                      </div>
                      <div className="flex gap-2">
                        <span className="text-purple-300 font-mono min-w-[120px]">Rule:</span>
                        <span className="text-cyan-300">{analysis.tagUpdate.rule}</span>
                      </div>
                      <div className="flex gap-2">
                        <span className="text-purple-300 font-mono min-w-[120px]">Rationale:</span>
                        <span className="text-purple-200 italic">{analysis.tagUpdate.rationale}</span>
                      </div>
                    </div>
                    <div className="mt-3 pt-3 border-t border-white/10">
                      <div className="text-xs text-purple-300">
                        ⚠️ This rule should be appended to the system's TAG structure memory for persistent behavioral adaptation.
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Meta-commentary */}
              <div className="bg-white/5 rounded-lg p-4 border border-purple-500/20">
                <div className="text-purple-300 font-semibold mb-2 text-sm">
                  🧠 Meta-Observation
                </div>
                <div className="text-purple-200 text-xs leading-relaxed">
                  This experiment successfully demonstrates that <span className="text-white font-semibold">Layer 3 (Autonomous Semantic Expansion)</span> can be reliably detected using the corrected ΔΦ formulation with absolute differences and fixed-scale normalization. The phase transition mechanism operates as theorized: extreme semantic discontinuities trigger a measurable shift in the system's operational layer, characterized by ΔΦ_EMA exceeding θ↑. The TAG update rule provides a concrete mechanism for translating these transitions into persistent behavioral adaptations, bridging theory and implementation.
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default APFPhaseTransitionTest;
